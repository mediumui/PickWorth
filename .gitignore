# ===== OS / editor junk =====
.DS_Store
Thumbs.db
desktop.ini
*.tmp
~$*

# ===== 内部脚本 / 数据 / 报告（不上 git，含 API key 等敏感信息）=====
# 构建/运维流水线：l4_render、sync_chrome、verify_refs、gen_llms_txt、l0~l2、
# rag_recall、vidshell_image_gen 等 + 关键词池 / 引用监控 / L2 素材 / 报告。
# 本地保留（脚本要跑），但绝不进 GitHub。部署侧由 .assetsignore 同步排除。
site/

# ===== Python (tools/*.py) =====
__pycache__/
*.py[cod]
*$py.exe
.Python
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
env/

# ===== WorkBuddy 运行时/会话数据（个人、非项目产物）=====
# .workbuddy/ 是工作区运行时目录：会话记忆、临时脚本、缓存。
# 不入库，避免把个人记忆与临时文件推到 GitHub。
.workbuddy/

# 临时生成物（若后续脚本落地缓存/抓取快照）
.cache/
*.cache
build/
dist/

# ===== 凭据 / 环境变量（保险：脚本本身已走 env，不硬编码）=====
.env
.env.*
!/.env.example
*.pem
*.key
